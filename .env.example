# Local Inference Backend: llama-cpp (default), ollama, vllm
OCR_BACKEND=llama-cpp

# Local Inference Endpoint
OCR_ENDPOINT=http://localhost:8080/v1

# Request Configuration
OCR_TIMEOUT=60
OCR_MAX_RETRIES=2
OCR_ALLOW_REMOTE=false

# Runtime Mode: managed (auto-detect and supervise llama-server) or custom (manual path)
OCR_RUNTIME_MODE=managed
OCR_MANAGED_BACKEND_OVERRIDE=auto
# OCR_LLAMA_SERVER_PATH='C:\path\to\llama-server.exe'
OCR_MODEL_REPO=ggml-org/GLM-OCR-GGUF
OCR_AUTO_START_SERVER=false

# Processing Parameters
OCR_DPI=100
# OCR_MAX_PAGES=50
OCR_MAX_IMAGE_DIMENSION=2048
